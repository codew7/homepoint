# =====================================================
# IMPORTANTE: Proteger Credenciales Sensibles
# =====================================================

# Archivos de configuración con credenciales
configSB.js
configSupabase.js
config.js
configAdm.js

# Backups de configuración
*.config.backup
*.config.old

# Archivos de entorno
.env
.env.local
.env.production

# Node modules (si se usa npm)
node_modules/
package-lock.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build outputs
dist/
build/
*.min.js
*.min.css

# Temporal files
tmp/
temp/
*.tmp

# Firebase cache
.firebase/
firebase-debug.log

# Supabase local
.supabase/

# =====================================================
# NOTA: Si ya subiste credenciales por error
# =====================================================
# 1. Regenera las API keys en Firebase/Supabase
# 2. Actualiza los archivos de config localmente
# 3. NO los subas al repositorio
# 4. Considera usar variables de entorno
# =====================================================
