{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": "formulario",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "cuestionario.json",
      "INSTRUCCIONES.md",
      ".htaccess",
      "**/.*"
    ],
    "headers": [
      { "source": "**/*.@(html|js|css|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
