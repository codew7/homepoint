{
"rules": {

    "pedidos": {
      ".indexOn": ["timestamp", "createdby", "cliente/email", "status", "entrega", "fecha", "vendedor"],
      ".read": true,
      "$id": {
        ".read": true,
        ".write": "(auth == null || auth.token.email !== 'homepoint2@homepoint.com') && ((!data.exists()) || (data.child('locked').val() === false) || (auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()))",
        "cobro": { ".validate": "!data.child('ts').exists() || newData.child('ts').val() === data.child('ts').val()" }
      }
    },

    "clientes": {
      ".indexOn": ["email", "nombre"],
      ".read": true,
      ".write": "newData.exists() && (auth == null || auth.token.email !== 'homepoint2@homepoint.com')"
    },

    "articulos": {
      ".indexOn": ["Disponible", "Codigo", "CodigoBarras"],
      ".read": true,
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "locatorpic": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'"
    },

    "reposicion": {
      ".read": true,
      "items": {
        ".indexOn": ["abierto", "dia"],
        "$id": {
          ".write": "auth == null || auth.token.email !== 'homepoint2@homepoint.com'",
          ".validate": "newData.hasChildren(['codigo', 'estado', 'dia', 'creado'])",
          "codigo": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "estado": { ".validate": "newData.isString() && newData.val().matches(/^(ofrecido|pedido|confirmado|rechazado|no)$/)" },
          "origen": { ".validate": "newData.isString() && newData.val().matches(/^(deposito|salon|lector)$/)" },
          "cant": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 1000" },
          "abierto": { ".validate": "newData.val() === true" },
          "dia": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "creado": { ".validate": "newData.isNumber()" },
          "resp": { ".validate": "newData.isNumber()" },
          "conf": { ".validate": "newData.isNumber()" },
          "creadoPor": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "respPor": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "confPor": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "$otro": { ".validate": false }
        }
      },
      "etiquetas": {
        "$codigo": {
          ".write": "auth == null || auth.token.email !== 'homepoint2@homepoint.com'",
          ".validate": "newData.isNumber()"
        }
      },
      "lector": {
        "estado": {
          ".write": "auth == null || auth.token.email !== 'homepoint2@homepoint.com'",
          "online": { ".validate": "newData.isBoolean()" },
          "bloqueado": { ".validate": "newData.isBoolean()" },
          "visto": { ".validate": "newData.isNumber()" },
          "desde": { ".validate": "newData.isNumber()" },
          "version": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "$otro": { ".validate": false }
        },
        "lecturas": {
          ".indexOn": ["ts"],
          "$id": {
            ".write": "auth == null || auth.token.email !== 'homepoint2@homepoint.com'",
            ".validate": "newData.hasChildren(['texto', 'ts', 'resultado'])",
            "texto": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "ts": { ".validate": "newData.isNumber()" },
            "resultado": { ".validate": "newData.isString() && newData.val().matches(/^(ok|ya|no-encontrado|varios)$/)" },
            "codigo": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "itemId": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "opciones": { "$i": { ".validate": "newData.isString() && newData.val().length <= 60" } },
            "resuelto": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "resueltoPor": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "$otro": { ".validate": false }
          }
        }
      }
    },

    "ubicaciones": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "movimientos": {
      ".indexOn": ["timestamp", "tipo", "pedidoId", "codigo"],
      ".read": true,
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      "$mov": {
        ".write": "auth != null && $mov.beginsWith('tr_') && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
      }
    },

    "gastos": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "clientesPotenciales": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".indexOn": ["creado", "estado"],
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
        ".validate": "newData.hasChildren(['nombre', 'telefono', 'email', 'localidad'])"
      }
    },

    "armadoVerificados": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
      "$codigo": {
        ".validate": "newData.isBoolean() || (newData.isNumber() && newData.val() >= 0) || newData.hasChildren()",
        "$pedido": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },

    "armadoIncluidos": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'"
    },

    "ajustes": {
      ".read": "auth != null",
      "cotizacionValidez24h": {
        ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
        ".validate": "newData.isBoolean()"
      }
    },

    "solicitudesSucursal": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
      ".indexOn": "creado",
      "$id": {
        ".read": true,
        "disponibles": { "$k": { ".write": "auth == null || auth.token.email !== 'homepoint2@homepoint.com'", ".validate": "newData.isBoolean()" } },
        "terminado": { ".write": "auth == null || auth.token.email !== 'homepoint2@homepoint.com'", ".validate": "newData.isNumber()" }
      }
    },

    "alias": {
      ".indexOn": ["alias"],
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "aliasUso": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "aliasDelDiaHistorial": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      "$fecha": {
        ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
        ".validate": "$fecha.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['cortes', 'rangos'])",
        "cortes": { ".validate": "newData.child('bajo').isNumber() && newData.child('alto').isNumber()" },
        "rangos": { "$rango": { ".validate": "$rango.matches(/^(bajo|medio|alto|envios)$/) && newData.isString() && newData.val().length <= 60" } },
        "$otro": { ".validate": false }
      }
    },

    "aliasDelDia": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".validate": "newData.hasChildren(['cortes', 'rangos', 'fecha', 'ts'])",
      "cortes": {
        ".validate": "newData.hasChildren(['bajo', 'alto']) && newData.child('bajo').isNumber() && newData.child('alto').isNumber() && newData.child('bajo').val() > 0 && newData.child('alto').val() > newData.child('bajo').val()"
      },
      "rangos": {
        "$rango": { ".validate": "$rango.matches(/^(bajo|medio|alto|envios)$/) && newData.isString() && newData.val().length <= 60" }
      },
      "fecha": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
      "por": { ".validate": "newData.isString() && newData.val().length <= 120" },
      "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
      "$otro": { ".validate": false }
    },

    "traspasos": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".indexOn": ["enviadoEn"],
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists() && (newData.exists() || root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root')"
      }
    },

    "traspasosMeta": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "cuentasCaseros": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'",
      "transferenciasDesde": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
      },
      "retiros": {
        "$id": {
          ".validate": "newData.hasChildren(['fecha', 'sentido', 'moneda', 'monto'])",
          "fecha": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "sentido": { ".validate": "newData.val() === 'CM' || newData.val() === 'MC'" },
          "moneda": { ".validate": "newData.val() === 'ARS' || newData.val() === 'USD'" },
          "monto": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "nota": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "creadoEn": { ".validate": "newData.isNumber()" },
          "creadoPor": { ".validate": "newData.isString()" },
          "cotizacion": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$otro": { ".validate": false }
        }
      },
      "blueDia": {
        "$dia": { ".validate": "$dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber() && newData.val() > 0" }
      },
      "$otro": { ".validate": false }
    },

    "movimientos2": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "facturacion": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "chat": { ".read": "auth != null", ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'" },

    "cajas": {
      ".read": "auth != null",
      "$caja": {
        ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
        "nombre": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "turno": { ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())" },
        "ultimo": { ".validate": "newData.hasChildren(['contado', 'ts'])" },
        "desde": { ".validate": "newData.isNumber()" },
        "$otro": { ".validate": false }
      }
    },

    "cajaTurnos": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'",
      ".indexOn": ["abiertoTs"],
      "$turno": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && !data.child('cerradoTs').exists()",
        "movs": {
          "$mov": {
            ".validate": "newData.hasChildren(['t', 'monto', 'por', 'ts']) && newData.child('monto').isNumber() && newData.child('t').isString() && newData.child('t').val().matches(/^(venta|devolucion|ajuste|anulacion|retiro|ingreso)$/)"
          }
        }
      }
    },

    "cajaPendientes": {
      ".read": "auth != null",
      "$pedido": {
        ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
        ".validate": "newData.hasChildren(['efectivo', 'ts']) && newData.child('efectivo').isNumber()"
      }
    },

    "usuariosIconos": {
      ".read": "auth != null",
      "$usuario": {
        ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^(gato|perro|zorro|oso|conejo|buho|pinguino|raton|cerdo|rana|pez|tortuga|leon|mono|koala|panda|vaca|pato)$/))"
      }
    },

    "usuariosClaves": {
      ".read": "auth != null",
      "$usuario": {
        ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
        ".validate": "!newData.exists() || (newData.hasChildren(['h', 's']) && newData.child('h').isString() && newData.child('h').val().length === 64 && newData.child('s').isString() && newData.child('s').val().length <= 32)"
      }
    },

    "transferenciasVerificadas": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
      "$pedidoId": {
        ".validate": "newData.isNumber()"
      }
    },

    "comprobantesEnviados": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
      "$comprobanteId": {
        ".validate": "newData.isNumber()"
      }
    },

    "cotizacionesVerificadas": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
      "$pedidoId": {
        ".validate": "newData.hasChildren(['blue', 'fecha']) && newData.child('blue').isNumber() && newData.child('blue').val() > 0 && newData.child('fecha').isNumber()"
      }
    },

    "registroCaja": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'",
      "archivos": {
        "$dia": {
          "$equipo": {
            ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && $dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $equipo.matches(/^[a-z0-9]{10,32}$/) && (newData.exists() ? (!data.exists() || newData.child('b').val() >= data.child('b').val()) : (data.child('t').val() < now - 7776000000 || (auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root')))",
            ".validate": "newData.hasChildren(['z', 'b', 't'])",
            "z": { ".validate": "newData.isString() && newData.val().length <= 2000000" },
            "b": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$otro": { ".validate": false }
          }
        }
      },
      "resumen": {
        "$dia": {
          "$equipo": {
            ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && $dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $equipo.matches(/^[a-z0-9]{10,32}$/) && (newData.exists() ? (!data.exists() || newData.child('b').val() >= data.child('b').val()) : (data.child('t').val() < now - 7776000000 || (auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root')))",
            ".validate": "newData.hasChildren(['b', 'n', 't'])",
            "b": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "n": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "u": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$otro": { ".validate": false }
          }
        }
      },
      "equipos": {
        "$equipo": {
          ".validate": "$equipo.matches(/^[a-z0-9]{10,32}$/)",
          "host": { ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'", ".validate": "newData.isString() && newData.val().length <= 60" },
          "ver": { ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'", ".validate": "newData.isString() && newData.val().length <= 20" },
          "pv": { ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'", ".validate": "newData.isString() && newData.val().length <= 60" },
          "visto": { ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'", ".validate": "newData.isNumber() && newData.val() <= now" },
          "nombre": { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'", ".validate": "newData.isString() && newData.val().length <= 40" },
          "$otro": { ".validate": false }
        }
      }
    },

    "2026": { ".read": "auth != null" },
    "2027": { ".read": "auth != null" },
    "2028": { ".read": "auth != null" },

    "catalogoCMS": {
      "publicado": {
        ".read": true,
        "$cat": {
          ".write": "auth != null && $cat.matches(/^(mayorista|interior)$/) && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'",
          ".validate": "newData.hasChildren(['version'])"
        }
      },
      "borrador": {
        ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'",
        "$cat": {
          ".write": "auth != null && $cat.matches(/^(mayorista|interior)$/) && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'"
        }
      },
      "historial": {
        ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'",
        "$cat": {
          ".indexOn": ["fecha"],
          "$version": {
            ".write": "auth != null && $cat.matches(/^(mayorista|interior)$/) && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root' && (!data.exists() || !newData.exists())",
            ".validate": "!newData.exists() || newData.hasChildren(['config', 'autor', 'fecha'])"
          }
        }
      },
      "plantillas": {
        ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'",
        ".write": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'"
      }
    },

    "dolar": {
      ".read": true,
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    }
  }
}
