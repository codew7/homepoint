<?xml version="1.0" encoding="utf-8"?>
<!-- Camara en vertical: visor 3:4, nivel, foto guia de la vez anterior.
     Arriba: grupo del deposito (FL, FR, BL, BR, OT) y columna/estante que
     se va a sacar. Abajo: hacia donde va la proxima foto (columna nueva a
     la derecha, o un estante mas abajo) y el disparador. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cam_fondo">

    <androidx.camera.view.PreviewView
        android:id="@+id/visor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <!-- "Piel de cebolla": la foto de la vez anterior, semitransparente. -->
    <ImageView
        android:id="@+id/piel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.42"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Al bajar un estante: la franja de abajo de la foto de arriba, para
         seguir desde ahi (se puede pisar un poco). -->
    <ImageView
        android:id="@+id/solape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ar.com.homepoint.locatorpic.NivelView
        android:id="@+id/nivel"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/foco"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/foco"
        android:visibility="invisible" />

    <View
        android:id="@+id/destello"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFF" />

    <!-- Arriba: grupo, columna y estado -->
    <LinearLayout
        android:id="@+id/arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="34dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/atras"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/fondo_boton_redondo_cam"
                android:contentDescription="Volver"
                android:src="@drawable/ic_atras" />

            <!-- FL FR BL BR OT (se arman en el codigo) -->
            <LinearLayout
                android:id="@+id/grupos"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/fondo_chip_cam"
                android:orientation="horizontal"
                android:padding="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_panel_cam"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="COLUMNA"
                    android:textColor="@color/cam_texto_2"
                    android:textFontWeight="800"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/columna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mono_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/cam_texto"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/subColumna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxWidth="210dp"
                    android:textColor="@color/cam_texto_2"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/chipSubidas"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/fondo_chip_cam"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/icSubidas"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nube" />

                    <TextView
                        android:id="@+id/txtSubidas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:textColor="@color/cam_texto"
                        android:textFontWeight="700"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/hdr"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/fondo_boton_redondo_cam"
                        android:contentDescription="HDR"
                        android:src="@drawable/ic_hdr"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/linterna"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/fondo_boton_redondo_cam"
                        android:contentDescription="Linterna"
                        android:src="@drawable/ic_rayo_off" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Abajo: aviso, deshacer, direccion de la proxima foto y disparador -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/aviso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/fondo_chip_cam"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="@color/cam_texto"
            android:textSize="12sp" />

        <!-- "Foto guardada · Deshacer" (unos segundos) -->
        <TextView
            android:id="@+id/deshacer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/fondo_chip_cam"
            android:paddingHorizontal="16dp"
            android:paddingVertical="9dp"
            android:textColor="@color/cam_texto"
            android:textFontWeight="700"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Hacia donde va la proxima foto -->
        <LinearLayout
            android:id="@+id/direccion"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/fondo_chip_cam"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/dirDerecha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/fondo_chip_cam"
                android:gravity="center"
                android:text="→  Columna nueva"
                android:textColor="@color/cam_texto"
                android:textFontWeight="800"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dirAbajo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/fondo_chip_cam"
                android:gravity="center"
                android:text="↓  Estante de abajo"
                android:textColor="@color/cam_texto"
                android:textFontWeight="800"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <!-- Foto guia de la vez anterior (tocar = superponer) -->
            <FrameLayout
                android:id="@+id/guia"
                android:layout_width="78dp"
                android:layout_height="104dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/fondo_panel_cam"
                android:clipToOutline="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/guiaImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto guía de la vez anterior"
                    android:scaleType="centerCrop" />

                <View
                    android:id="@+id/guiaBorde"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/guia_borde"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/guiaTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#99000000"
                    android:gravity="center"
                    android:paddingVertical="3dp"
                    android:textColor="@color/cam_texto"
                    android:textFontWeight="700"
                    android:textSize="10sp" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/disparar"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/disparador"
                android:contentDescription="Sacar foto" />

            <ImageButton
                android:id="@+id/verGrilla"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/fondo_boton_redondo_cam"
                android:contentDescription="Ver la cuadrícula"
                android:src="@drawable/ic_grilla" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
