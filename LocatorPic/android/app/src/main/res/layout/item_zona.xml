<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/fondo_tarjeta"
    android:clipToOutline="true"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/miniatura"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@color/borde"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/numero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="@drawable/fondo_numero_zona"
        android:fontFamily="@font/mono_bold"
        android:paddingHorizontal="7dp"
        android:paddingVertical="1dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/estado"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/fondo_boton_redondo_cam"
        android:contentDescription="@null"
        android:padding="4dp"
        app:tint="#FFFFFF" />
</FrameLayout>
