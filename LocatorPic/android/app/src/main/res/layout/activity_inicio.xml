<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Txt.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LocatorPic" />

                <TextView
                    android:id="@+id/usuario"
                    style="@style/Txt.Cuerpo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/salir"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar sesión"
                android:src="@drawable/ic_salir"
                app:tint="@color/apagado" />
        </LinearLayout>

        <!-- Aviso: falta configurar Firebase -->
        <TextView
            android:id="@+id/sinConfig"
            style="@style/Txt.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/fondo_tarjeta"
            android:backgroundTint="@color/peligro_suave"
            android:padding="16dp"
            android:text="Falta configurar Firebase (google-services.json). Ver README de LocatorPic."
            android:textColor="@color/peligro"
            android:visibility="gone" />

        <!-- Subidas -->
        <LinearLayout
            android:id="@+id/chipSubidas"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/fondo_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/icSubidas"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nube"
                app:tint="@color/acento" />

            <TextView
                android:id="@+id/txtSubidas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/acento"
                android:textFontWeight="700"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Recorrido en curso / nuevo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tituloActual"
                style="@style/Txt.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/numZonas"
                    style="@style/Txt.Numero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/txtZonas"
                    style="@style/Txt.Cuerpo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/detalleActual"
                style="@style/Txt.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/principal"
                style="@style/Boton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:icon="@drawable/ic_camara"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

            <LinearLayout
                android:id="@+id/accionesCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/verZonas"
                    style="@style/Boton.Borde"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ver zonas"
                    app:icon="@drawable/ic_grilla"
                    app:iconTint="@color/texto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/descartar"
                    style="@style/Boton.Borde"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:contentDescription="Descartar recorrido"
                    app:icon="@drawable/ic_basura"
                    app:iconPadding="0dp"
                    app:iconTint="@color/peligro" />
            </LinearLayout>
        </LinearLayout>

        <!-- Último recorrido terminado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/Txt.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Último recorrido terminado" />

            <TextView
                android:id="@+id/ultimoFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/texto"
                android:textFontWeight="700"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/ultimoPunto"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/fondo_chip"
                    android:backgroundTint="@color/apagado" />

                <TextView
                    android:id="@+id/ultimoEstado"
                    style="@style/Txt.Cuerpo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Txt.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Consejo: hacé siempre el mismo recorrido y repetí el encuadre de la foto guía. Así cada número de zona es siempre la misma estantería."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
