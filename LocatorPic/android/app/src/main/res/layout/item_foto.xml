<?xml version="1.0" encoding="utf-8"?>
<!-- Una foto de la cuadricula: miniatura, estado de subida y estante. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="104dp"
    android:layout_height="138dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/fondo_foto_celda"
    android:clipToOutline="true"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/miniatura"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/estado"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/fondo_boton_redondo_cam"
        android:contentDescription="@null"
        android:padding="4dp"
        app:tint="#FFFFFF" />

    <!-- "E2" cuando la columna tiene mas de una foto -->
    <TextView
        android:id="@+id/estante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:background="@drawable/fondo_numero_zona"
        android:fontFamily="@font/mono_bold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />
</FrameLayout>
