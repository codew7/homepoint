<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/atras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_atras"
            app:tint="@color/texto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Txt.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zonas del recorrido"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/resumen"
                style="@style/Txt.Cuerpo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/vacio"
        style="@style/Txt.Cuerpo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="Todavía no hay fotos en este recorrido."
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grilla"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tarjeta"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/seguir"
            style="@style/Boton.Borde"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Seguir"
            app:icon="@drawable/ic_camara"
            app:iconTint="@color/texto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/finalizar"
            style="@style/Boton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4"
            android:text="Finalizar"
            app:icon="@drawable/ic_bandera"
            app:iconTint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
