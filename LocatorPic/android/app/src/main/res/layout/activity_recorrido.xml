<?xml version="1.0" encoding="utf-8"?>
<!-- Cuadricula del recorrido: una pestaña por grupo (FL, FR, BL, BR, OT) y,
     abajo, sus columnas una al lado de la otra con sus fotos de arriba
     hacia abajo. Los "+" agregan una columna o un estante. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/atras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_atras"
            app:tint="@color/texto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Txt.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Columnas del recorrido"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/resumen"
                style="@style/Txt.Cuerpo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pestañas de grupo (se arman en el codigo) -->
    <LinearLayout
        android:id="@+id/pestanias"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/fondo_tarjeta"
        android:orientation="horizontal"
        android:padding="4dp" />

    <TextView
        android:id="@+id/infoGrupo"
        style="@style/Txt.Cuerpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <HorizontalScrollView
            android:id="@+id/desplazar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/cuadricula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tarjeta"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/seguir"
            style="@style/Boton.Borde"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Seguir"
            app:icon="@drawable/ic_camara"
            app:iconTint="@color/texto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/finalizar"
            style="@style/Boton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4"
            android:text="Finalizar"
            app:icon="@drawable/ic_bandera"
            app:iconTint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
