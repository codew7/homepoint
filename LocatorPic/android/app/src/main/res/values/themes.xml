<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pantallas de gestion: claras, estetica HomePoint. -->
    <style name="Tema.LocatorPic" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/acento</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/primario</item>
        <item name="colorSurface">@color/tarjeta</item>
        <item name="colorError">@color/peligro</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <!-- Camara y revision: negro, pantalla completa, sin distracciones. -->
    <style name="Tema.LocatorPic.Camara" parent="Tema.LocatorPic">
        <item name="android:windowBackground">@color/cam_fondo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:textColor">@color/cam_texto</item>
    </style>

    <!-- Textos reutilizables -->
    <style name="Txt" parent="">
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textColor">@color/texto</item>
    </style>
    <style name="Txt.Titulo">
        <item name="android:textSize">24sp</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Txt.Etiqueta">
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/apagado</item>
    </style>
    <style name="Txt.Cuerpo">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/texto_2</item>
    </style>
    <style name="Txt.Numero">
        <item name="android:fontFamily">@font/mono_bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <!-- Botones -->
    <style name="Boton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/acento</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="Boton.Oscuro">
        <item name="backgroundTint">@color/primario</item>
    </style>
    <style name="Boton.Exito">
        <item name="backgroundTint">@color/exito</item>
    </style>
    <style name="Boton.Borde" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/borde</item>
        <item name="android:textColor">@color/texto</item>
    </style>
</resources>
