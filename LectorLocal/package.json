{
  "name": "lector-homepoint",
  "productName": "Lector HomePoint",
  "version": "1.1.1",
  "description": "Lector de Reposición: la PC con la pistola que le avisa al salón",
  "author": "HomePoint",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "armar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/armar.ps1",
    "subir": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/subir.ps1"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.homepoint.lector",
    "productName": "Lector HomePoint",
    "copyright": "HomePoint",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Lector-HomePoint-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lector HomePoint",
      "uninstallDisplayName": "Lector HomePoint",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/codew7/homepoint/releases/download/lector-win"
    }
  }
}
