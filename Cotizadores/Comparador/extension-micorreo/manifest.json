{
  "manifest_version": 3,
  "name": "Cotizador de envíos → MiCorreo",
  "version": "1.0.0",
  "description": "Completa en MiCorreo el envío que elegiste en el Cotizador de envíos, en tu navegador y con tus cuentas.",
  "icons": { "128": "icono.png" },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "fondo.js" },
  "content_scripts": [
    {
      "matches": ["https://www.correoargentino.com.ar/MiCorreo/*", "https://micorreo.correoargentino.com.ar/*"],
      "js": ["puente.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.correoargentino.com.ar/MiCorreo/public/envioCla*"],
      "js": ["rellenar.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
