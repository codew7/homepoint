{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "usuarios": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "nombre": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "activo": { ".validate": "newData.isBoolean()" },
        "debeCambiarClave": {
          ".write": "auth != null && auth.uid === $uid && newData.val() === false",
          ".validate": "newData.isBoolean()"
        },
        "ultimoIngreso": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "tiendas": { "$tienda": { ".validate": "newData.val() === true" } }
      }
    },

    "bajas": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['fecha']) && newData.child('fecha').isNumber()",
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "fecha": { ".validate": "newData.val() <= now" },
        "$otro": { ".validate": false }
      }
    },

    "registros": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && (!data.exists() || !newData.exists())))",
        ".validate": "newData.hasChildren(['tiendaNombre', 'tienda', 'nombre', 'email', 'fecha'])",
        "tiendaNombre": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "tienda": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9][a-z0-9-]{1,30}$/) && !root.child('tiendas').child(newData.val()).exists()" },
        "url": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "nombre": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
        "email": { ".validate": "newData.isString() && auth.token.email != null && newData.val() === auth.token.email.toLowerCase()" },
        "comentario": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "fecha": { ".validate": "newData.val() === now" },
        "$otro": { ".validate": false }
      }
    },

    "solicitudes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['email', 'tienda', 'fecha']) && newData.child('email').isString() && newData.child('email').val().length <= 200 && newData.child('tienda').isString() && newData.child('tienda').val().length <= 40 && newData.child('fecha').val() === now"
      }
    },

    "tiendas": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$tienda": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "config": {
          ".read": true,
          ".write": "auth != null && root.child('tiendas').child($tienda).child('admins').child(auth.uid).val() === true && root.child('usuarios').child(auth.uid).child('activo').val() !== false",
          ".validate": "newData.hasChildren(['identidad', 'precios'])",
          "precios": {
            "escalas": {
              "$i": {
                "hasta": { ".validate": "newData.isNumber() && newData.val() > 0" },
                "pct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" }
              }
            },
            "pctExcedente": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" }
          },
          "catalogo": {
            "articulosOcultos": {
              "$i": { ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().length <= 160" }
            }
          }
        },
        "assets": {
          ".read": true,
          "$asset": {
            ".write": "auth != null && root.child('tiendas').child($tienda).child('admins').child(auth.uid).val() === true && root.child('usuarios').child(auth.uid).child('activo').val() !== false",
            ".validate": "newData.hasChildren(['dataUrl']) && newData.child('dataUrl').isString() && newData.child('dataUrl').val().beginsWith('data:image/') && newData.child('dataUrl').val().length < 1500000"
          }
        },
        "costo": {
          ".read": true,
          ".validate": "newData.hasChildren(['modo'])",
          "modo": { ".validate": "newData.val() === 'costo' || newData.val() === 'costoPct'" },
          "pct": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 500" },
          "$otro": { ".validate": false }
        },
        "estado": {
          ".read": true,
          ".write": "auth != null && root.child('tiendas').child($tienda).child('admins').child(auth.uid).val() === true && root.child('usuarios').child(auth.uid).child('activo').val() !== false && (!data.exists() || data.child('activa').val() !== false || data.child('pausadaPor').val() === 'tienda') && (newData.child('activa').val() === true || newData.child('pausadaPor').val() === 'tienda')",
          "activa": { ".validate": "newData.isBoolean()" },
          "mensaje": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "pausadaPor": { ".validate": "newData.val() === 'tienda' || newData.val() === 'admin'" },
          "desde": { ".validate": "newData.isNumber() && newData.val() <= now" }
        },
        "baja": {
          ".read": "auth != null && root.child('tiendas').child($tienda).child('admins').child(auth.uid).val() === true",
          ".write": "auth != null && root.child('tiendas').child($tienda).child('admins').child(auth.uid).val() === true && root.child('usuarios').child(auth.uid).child('activo').val() !== false",
          ".validate": "newData.hasChildren(['fecha', 'uid', 'borrarUsuario'])",
          "fecha": { ".validate": "newData.val() === now" },
          "uid": { ".validate": "newData.val() === auth.uid" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "borrarUsuario": { ".validate": "newData.isBoolean()" },
          "motivo": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "$otro": { ".validate": false }
        },
        "admins": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        },
        "ultimoPedido": {
          ".write": "newData.val() === now && (!data.exists() || now - data.val() >= 3000)",
          ".validate": "newData.isNumber()"
        },
        "pedidos": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('tiendas').child($tienda).child('admins').child(auth.uid).val() === true && root.child('usuarios').child(auth.uid).child('activo').val() !== false))",
          ".indexOn": ["fecha"],
          "$pedido": {
            ".write": "(!data.exists() && newData.exists() && $pedido.matches(/^[a-z0-9]{10,20}$/) && newData.parent().parent().child('ultimoPedido').val() === now && root.child('tiendas').child($tienda).child('config').exists() && root.child('tiendas').child($tienda).child('estado').child('activa').val() !== false) || (auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('tiendas').child($tienda).child('admins').child(auth.uid).val() === true && root.child('usuarios').child(auth.uid).child('activo').val() !== false)))",
            ".validate": "newData.hasChildren(['numero', 'fecha', 'status', 'cliente', 'items', 'total'])",
            "numero": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z2-9]{5}$/) && (!data.exists() || data.val() === newData.val())" },
            "fecha": { ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === now" },
            "status": { ".validate": "data.exists() ? (newData.val() === 'ABIERTO' || newData.val() === 'ENTREGADO') : newData.val() === 'ABIERTO'" },
            "entregado": { ".validate": "data.parent().exists() && newData.isNumber() && newData.val() <= now" },
            "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000000" },
            "cliente": {
              ".validate": "newData.hasChildren(['nombre', 'telefono', 'email', 'provincia', 'localidad'])",
              "nombre": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
              "telefono": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8,15}$/)" },
              "email": { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)" },
              "provincia": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
              "localidad": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
              "entrega": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "dni": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{7,8}$/)" },
              "direccion": { ".validate": "newData.isString() && newData.val().length <= 140" },
              "notas": { ".validate": "newData.isString() && newData.val().length <= 400" },
              "$otro": { ".validate": false }
            },
            "items": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['nombre', 'cantidad', 'precio'])",
                "codigo": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "nombre": { ".validate": "newData.isString() && newData.val().length <= 160" },
                "cantidad": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000" },
                "precio": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000" },
                "costo": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 100000000" },
                "$otro": { ".validate": false }
              }
            },
            "$otro": { ".validate": false }
          }
        }
      }
    }
  }
}
