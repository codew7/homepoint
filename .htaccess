# Hostinger (home-point-admin.dev.ar)
# Por defecto Hostinger manda los .js/.css con "guardar 7 días", y su CDN
# y los navegadores siguen sirviendo la versión vieja después de cada cambio.
# "no-cache" no apaga la caché: obliga a preguntarle al servidor si el
# archivo cambió antes de usarlo. Si no cambió, la respuesta es mínima (304);
# si cambió, llega el nuevo. Así no hace falta versionar nada a mano.
# GitHub Pages ignora este archivo.

<IfModule mod_headers.c>
  <FilesMatch "\.(html?|js|css|json)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  <FilesMatch "\.(html?|js|css|json)$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>
