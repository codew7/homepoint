# Copiá este archivo como ".env" (en esta misma carpeta) y completá los datos.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# ID de la planilla (config.js -> GOOGLE_SHEETS_CONFIG.SPREADSHEET_ID).
# Se lee la hoja "Lista" como CSV: la planilla tiene que estar compartida con enlace.
SPREADSHEET_ID=1cD50d0-oSTogEe9tYo9ABUSP1ONCy3SAV92zsYYIG84

# Base de datos de Firebase (proyecto Munro)
FIREBASE_DB_URL=https://pedidos-87064-default-rtdb.firebaseio.com

# Ruta al archivo de cuenta de servicio de Firebase (descargado desde la consola).
# Guardalo FUERA de la carpeta del proyecto, por ejemplo:
FIREBASE_CREDENCIALES=C:\HomePoint\credenciales\firebase-pedidos-87064.json

# Bucket de Firebase Storage donde la app LocatorPic sube las fotos.
FIREBASE_BUCKET=pedidos-87064.firebasestorage.app

# Carpeta de la PC donde se baja el último recorrido de LocatorPic.
# OJO: cada descarga BORRA lo que había (las fotos del recorrido anterior).
RELEVAMIENTO_CARPETA=C:\HomePoint\Relevamiento\actual

# Modelo de Claude (opcional). Vacío = el que tengas elegido en Claude Code.
# Ejemplos: sonnet  (rinde más con el límite de la suscripción)  /  opus  (más preciso)
CLAUDE_MODELO=
