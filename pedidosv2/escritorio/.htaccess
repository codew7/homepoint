# La app de escritorio lee version.txt para saber si hay versión nueva.
# Sin esto el CDN de Hostinger lo guardaría días y las PCs no verían la
# actualización. El .exe se pide con ?v=<versión> y se verifica su huella,
# así que una copia vieja en caché nunca se instala por error.
<IfModule mod_headers.c>
  <FilesMatch "\.(txt|exe)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  <FilesMatch "\.(txt|exe)$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>
