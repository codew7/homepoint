{
"rules": {

    "pedidos": {
      ".indexOn": ["timestamp", "createdby", "cliente/email", "status", "entrega", "fecha", "vendedor"],
      ".read": true,
      "$id": {
        ".read": true,
        ".write": "(auth == null || auth.token.email !== 'homepoint2@homepoint.com') && ((!data.exists()) || (data.child('locked').val() === false) || (auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()))"
      }
    },

    "clientes": {
      ".indexOn": ["email", "nombre"],
      ".read": true,
      ".write": "newData.exists() && (auth == null || auth.token.email !== 'homepoint2@homepoint.com')"
    },

    "articulos": {
      ".indexOn": ["Disponible", "Codigo", "CodigoBarras"],
      ".read": true,
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "locatorpic": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'"
    },

    "ubicaciones": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "movimientos": {
      ".indexOn": ["timestamp", "tipo", "pedidoId", "codigo"],
      ".read": true,
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      "$mov": {
        ".write": "auth != null && $mov.beginsWith('tr_') && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
      }
    },

    "gastos": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "armadoVerificados": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
      "$codigo": {
        ".validate": "newData.isBoolean() || (newData.isNumber() && newData.val() >= 0)"
      }
    },

    "armadoIncluidos": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'"
    },

    "solicitudesSucursal": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
      ".indexOn": "creado",
      "$id": {
        ".read": true,
        "disponibles": { "$k": { ".write": "auth == null || auth.token.email !== 'homepoint2@homepoint.com'", ".validate": "newData.isBoolean()" } },
        "terminado": { ".write": "auth == null || auth.token.email !== 'homepoint2@homepoint.com'", ".validate": "newData.isNumber()" }
      }
    },

    "alias": {
      ".indexOn": ["alias"],
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "aliasUso": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "clientesPotenciales": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".indexOn": ["creado", "estado"],
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists())",
        ".validate": "newData.hasChildren(['nombre', 'telefono', 'email', 'localidad'])"
      }
    },

    "traspasos": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".indexOn": ["enviadoEn"],
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists() && (newData.exists() || root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root')"
      }
    },

    "cuentasCaseros": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).child('rol').val() === 'root'",
      "transferenciasDesde": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
      },
      "retiros": {
        "$id": {
          ".validate": "newData.hasChildren(['fecha', 'sentido', 'moneda', 'monto'])",
          "fecha": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "sentido": { ".validate": "newData.val() === 'CM' || newData.val() === 'MC'" },
          "moneda": { ".validate": "newData.val() === 'ARS' || newData.val() === 'USD'" },
          "monto": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "nota": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "creadoEn": { ".validate": "newData.isNumber()" },
          "creadoPor": { ".validate": "newData.isString()" },
          "$otro": { ".validate": false }
        }
      },
      "$otro": { ".validate": false }
    },

    "traspasosMeta": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "movimientos2": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "facturacion": {
      ".read": "auth != null && root.child('admins').child(auth.token.email.replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    },

    "chat": { ".read": "auth != null", ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'" },

    "transferenciasVerificadas": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com'",
      "$pedidoId": {
        ".validate": "newData.isNumber()"
      }
    },

    "2026": { ".read": "auth != null" },
    "2027": { ".read": "auth != null" },
    "2028": { ".read": "auth != null" },

    "dolar": {
      ".read": true,
      ".write": "auth != null && auth.token.email !== 'homepoint2@homepoint.com' && root.child('admins').child(auth.token.email.replace('.', ',')).exists()"
    }
  }
}
