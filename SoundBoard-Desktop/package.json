{
  "name": "soundboard-showroom",
  "productName": "SoundBoard Showroom",
  "version": "1.0.0",
  "description": "Avisos de audio programados para el showroom",
  "author": "Homepoint",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ar.dev.homepoint.soundboard",
    "productName": "SoundBoard Showroom",
    "copyright": "Homepoint",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoundBoard Showroom",
      "runAfterFinish": true,
      "artifactName": "SoundBoard-Showroom-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "SoundBoard Showroom"
    },
    "publish": null
  }
}
