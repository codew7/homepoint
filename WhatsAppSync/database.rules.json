{
  "rules": {
    ".read": false,
    ".write": false,
    "chats": {
      "$tel": {
        ".read": "auth != null",
        "msgs": {
          ".indexOn": [
            "t"
          ]
        }
      }
    },
    "imgs": {
      "$tel": {
        "$id": {
          ".read": "auth != null"
        }
      }
    },
    "imgsIdx": {
      ".read": "auth != null",
      ".indexOn": [
        "t",
        "tel",
        "pedido"
      ]
    },
    "asigManual": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null",
        ".validate": "!newData.exists() || (newData.child('t').isNumber() && (!newData.child('pedido').exists() || newData.child('pedido').isString()))"
      }
    }
  }
}
