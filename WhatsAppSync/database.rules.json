{
  "rules": {
    ".read": false,
    ".write": false,
    "lineas": {
      "$linea": {
        ".validate": "$linea === 'envios' || $linea === 'munro' || $linea === 'caseros'",
        "chats": {
          "$tel": {
            ".read": "auth != null",
            "msgs": {
              ".indexOn": [
                "t"
              ]
            }
          }
        },
        "imgs": {
          "$tel": {
            "$id": {
              ".read": "auth != null"
            }
          }
        },
        "imgsIdx": {
          ".read": "auth != null",
          ".indexOn": [
            "t",
            "tel",
            "pedido"
          ]
        },
        "asigManual": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null",
            ".validate": "!newData.exists() || (newData.child('t').isNumber() && (!newData.child('pedido').exists() || newData.child('pedido').isString()))"
          }
        },
        "despachos": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['tel', 'link', 't'])",
            "tel": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{10}$/)"
            },
            "link": {
              ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val().beginsWith('https://') || newData.val().beginsWith('http://'))"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "nombre": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "por": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "info": {
          ".read": "auth != null"
        }
      }
    },
    "actualizacion": {
      ".read": true
    }
  }
}
