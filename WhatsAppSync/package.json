{
  "name": "whatsappsync",
  "version": "1.1.0",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "motor": "node index.js",
    "instalador": "electron-builder --win nsis --publish never"
  },
  "keywords": [],
  "author": "HomePoint",
  "license": "ISC",
  "description": "Guarda los chats de WhatsApp del local para verlos en pedidosv2 (solo lectura)",
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "firebase-admin": "^14.5.0",
    "pdf-to-img": "^7.0.2",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "private": true,
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "productName": "WhatsAppSync",
  "build": {
    "appId": "com.homepoint.whatsappsync",
    "productName": "WhatsAppSync",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "ajustes.js",
      "app/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icono.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "shortcutName": "WhatsAppSync",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://localhost/sin-actualizaciones"
      }
    ]
  }
}
